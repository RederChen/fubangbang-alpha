CAMPUSLINK_APP_NAME=CampusLink Backend
CAMPUSLINK_APP_ENV=development
CAMPUSLINK_DEBUG=true
CAMPUSLINK_API_PREFIX=/api

# 本地零配置运行可使用 SQLite；联调/部署请切换为下面的 PostgreSQL 地址。
CAMPUSLINK_DATABASE_URL=sqlite:///./data/campuslink.db
# CAMPUSLINK_DATABASE_URL=postgresql+psycopg://campuslink:campuslink@localhost:5432/campuslink

# 生产环境必须替换为随机长密钥，例如：openssl rand -hex 32
CAMPUSLINK_JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes-long
CAMPUSLINK_JWT_ALGORITHM=HS256
CAMPUSLINK_ACCESS_TOKEN_EXPIRE_MINUTES=10080

CAMPUSLINK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CAMPUSLINK_AUTO_CREATE_TABLES=true
CAMPUSLINK_SEED_DEMO_DATA=true

# 商品封面存储目录，部署时需持久化
CAMPUSLINK_UPLOAD_DIR=./data/uploads

# Render uses persistent Supabase Storage instead of the local directory.
CAMPUSLINK_UPLOAD_STORAGE=local
# CAMPUSLINK_UPLOAD_STORAGE=supabase
# CAMPUSLINK_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# CAMPUSLINK_SUPABASE_STORAGE_KEY=SERVER-ONLY-SECRET-DO-NOT-COMMIT
# CAMPUSLINK_SUPABASE_STORAGE_BUCKET=campuslink-images

# 同源部署时指向前端构建目录的绝对路径（本地开发可留空）
# CAMPUSLINK_FRONTEND_DIST=D:/path/to/CampusLink/.releases/<release>/site
# 正式模式需 PostgreSQL、私有随机 JWT 密钥，并关闭 debug、种子数据和自动建表。
# CAMPUSLINK_APP_ENV=production
# CAMPUSLINK_DEBUG=false
# CAMPUSLINK_SEED_DEMO_DATA=false
# CAMPUSLINK_AUTO_CREATE_TABLES=false
