{
  "name": "fubangbang-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node scripts/start_local.js",
    "start:postgres": "node scripts/start_local.js --postgres",
    "build:release": "node scripts/build_release.js",
    "start:release": "node scripts/start_release.js",
    "package:release": "python scripts/package_delivery.py",
    "setup:postgres": "node scripts/postgres_cli.js setup",
    "postgres:status": "node scripts/postgres_cli.js status",
    "postgres:stop": "node scripts/postgres_cli.js stop",
    "migrate:postgres": "node scripts/postgres_cli.js migrate",
    "backup:postgres": "node scripts/postgres_cli.js backup",
    "upgrade:postgres": "node scripts/postgres_cli.js upgrade",
    "restore:postgres": "node scripts/postgres_cli.js restore",
    "test:postgres": "node scripts/postgres_cli.js validate",
    "setup:backend": "node scripts/setup_backend.js",
    "test:e2e": "node scripts/run_e2e.js",
    "test:titles": "node scripts/test_product_titles_e2e.js",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "verify": "node scripts/verify_layout.js",
    "screenshot": "node scripts/take_screenshots.js"
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "puppeteer-core": "^25.14.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^3.3.13"
  }
}
