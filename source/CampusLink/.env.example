# ─────────────────────────────────────────────────────────────
#  福帮帮 (CampusLink) 前端环境变量模板
#  用法：复制本文件为 .env，按需修改。.env 已被 .gitignore 忽略。
# ─────────────────────────────────────────────────────────────

# 后端 REST API 基地址；开发与预览默认由 Vite 代理。
# 部署时需将 /api 转发到后端，或指定完整 API 地址。
VITE_API_BASE_URL=/api

# ─────────────────────────────────────────────────────────────
#  联调提示
#  - 后端 FastAPI 默认监听 8000 端口：uvicorn src.main:app --reload
#  - 若前端 5173 直连 8000 出现 CORS 报错，二选一：
#      1) 在 vite.config.ts 配置 server.proxy（推荐，见下）
#      2) 让后端开启 CORSMiddleware
#
#  vite.config.ts 代理示例：
#    server: {
#      port: 5173,
#      proxy: {
#        '/api': { target: 'http://localhost:8000', changeOrigin: true }
#      }
#    }
#  启用代理后，本文件应改为：
#    VITE_API_BASE_URL=/api
# ─────────────────────────────────────────────────────────────
